DATABASE_URL=postgresql://queue:queue@localhost:5432/queue?schema=public
REDIS_URL=redis://localhost:6379
DEMO_API_TOKEN=local-demo-token-change-me
API_URL=http://localhost:4000
PORT=4000
WORKER_CONCURRENCY=4
COOKIE_SECURE=false
# Override these if other projects already use the standard host ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
# Each isolated test/deployment can use its own Redis namespace.
QUEUE_PREFIX=djqp
# Renewable claim leases; workers recover expired claims after crashes.
WORKER_LOCK_MS=15000
STALLED_INTERVAL_MS=15000
# Optional canonical browser origin for an HTTPS reverse proxy. No trailing slash.
# WEB_ORIGIN=https://queue.example.test
